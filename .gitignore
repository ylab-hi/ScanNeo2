# Local Claude Code config (commands, settings) — keep out of repo for now
.claude/

# Python bytecode
__pycache__/
*.pyc

# Pytest
.pytest_cache/

# MkDocs build output
/site/

# Workflow run output. Anchored to the repo root on purpose: the integration
# tests keep tracked expected-output fixtures under .tests/integration/*/results/,
# which a depth-agnostic pattern would silently ignore.
/results/
/logs/

# TESLA benchmark export. Regenerated from the tracked tables by
# `python benchmark/tesla_recall.py --export <file>`; ~0.9 MB and specific to one
# pipeline run, so the headline numbers live in benchmark/TESLA/README.md instead.
/benchmark/TESLA/scanneo2_matched_predictions.tsv
